{
  "name": "NCX Portal Emissions App (ENG-2075 SEAL Golden Path)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "containerEnv": {
    "ALLOW_LOCAL_DEV_AUTH": "true",
    "PYTHONPATH": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install streamlit google-cloud-bigquery google-auth requests pandas numpy pytest ruff bandit",
  "postAttachCommand": {
    "streamlit": "streamlit run src/app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "NCX Portal Emissions Dashboard (Streamlit)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
